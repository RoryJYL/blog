{
  "name": "blog",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Personal blog site of Rory",
  "scripts": {
    "predev": "velite build",
    "dev": "concurrently -n velite,rr -c magenta,cyan \"velite --watch\" \"react-router dev\"",
    "dev:remote": "GAMER_API_SOURCE=remote pnpm dev",
    "build": "velite build && react-router build && node scripts/gen-static.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "velite build && react-router typegen && tsc --noEmit",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@iconify/react": "^6.0.4",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.77.0",
    "motion": "^12.27.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-medium-image-zoom": "^5.4.9",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@react-router/dev": "^8.5.2",
    "@react-router/node": "^8.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "github-slugger": "^2.0.0",
    "reading-time-estimator": "^1.11.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "velite": "^0.4.0",
    "vite": "^7.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "wrangler": "^4.166.0"
  }
}
